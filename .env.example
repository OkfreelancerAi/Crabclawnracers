# ===========================================
# Crab Claw Racers – Environment Variables
# ===========================================

# Required: The wallet that receives real USDC payouts on Base
NEXT_PUBLIC_RECIPIENT_WALLET=0xYourRealWalletAddressHere

# Optional: Custom Base RPC (defaults to public https://mainnet.base.org)
NEXT_PUBLIC_BASE_RPC=https://mainnet.base.org

# Optional: Comma-separated list of confirmed payout TX hashes
# Only hashes that are actually confirmed on Base will be displayed
CONFIRMED_PAYOUT_TXS=0xabc123...,0xdef456...

# Never put private keys or secrets that can move funds in this file.